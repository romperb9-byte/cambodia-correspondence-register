          text: "  \'\341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204\341\236\237\341\237\201\341\236\212\341\237\222\341\236\213\341\236\200\341\236\267\341\236\205\341\237\222\341\236\205 \341\236\223\341\236\267\341\236\204\341\236\240\341\236\267\341\236\232\341\236\211\341\237\222\341\236\211\341\236\234\341\236\217\341\237\222\341\236\220\341\236\273\',"
