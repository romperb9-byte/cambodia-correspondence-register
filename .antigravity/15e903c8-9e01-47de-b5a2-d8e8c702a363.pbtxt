        }
        lines {
          text: "  \'\341\236\230\341\236\223\341\237\222\341\236\221\341\236\270\341\236\232\341\236\242\341\236\224\341\237\213\341\236\232\341\237\206 \341\236\231\341\236\273\341\236\234\341\236\207\341\236\223 \341\236\223\341\236\267\341\236\204\341\236\200\341\236\270\341\236\241\341\236\266 \341\236\232\341\236\266\341\236\207\341\236\222\341\236\266\341\236\223\341\236\270\341\236\227\341\237\222\341\236\223\341\237\206\341\236\226\341\237\201\341\236\211\',"
