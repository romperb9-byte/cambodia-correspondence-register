          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <p className=\"text-xs text-slate-600 leading-relaxed\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            \341\236\221\341\236\267\341\236\223\341\237\222\341\236\223\341\236\223\341\237\220\341\236\231\341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\341\236\224\341\236\266\341\236\223\341\236\232\341\236\200\341\237\222\341\236\237\341\236\266\341\236\221\341\236\273\341\236\200\341\236\200\341\237\222\341\236\223\341\236\273\341\236\204 Google Sheets \341\236\217\341\236\266\341\236\230\341\236\232\341\236\231\341\237\210 Google Apps Script Web App API\341\237\224 \341\236\224\341\237\222\341\236\232\341\236\226\341\237\220\341\236\223\341\237\222\341\236\222\341\236\223\341\236\271\341\236\204\341\236\242\341\236\266\341\236\223 \341\236\223\341\236\267\341\236\204\341\236\237\341\236\232\341\236\237\341\237\201\341\236\232\341\236\221\341\237\205\341\236\237\341\236\223\341\237\222\341\236\233\341\236\271\341\236\200\341\236\200\341\236\267\341\236\205\341\237\222\341\236\205\341\236\200\341\236\266\341\236\232 <strong>OutgoingLetters</strong> \341\236\223\341\236\267\341\236\204 <strong>IncomingLetters</strong> \341\236\212\341\237\204\341\236\231\341\236\237\341\237\222\341\236\234\341\237\220\341\236\231\341\236\224\341\237\222\341\236\232\341\236\234\341\236\217\341\237\222\341\236\217\341\236\267\341\237\224"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
