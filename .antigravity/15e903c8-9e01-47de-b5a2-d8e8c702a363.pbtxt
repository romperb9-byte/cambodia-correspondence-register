  planner_response {
    response: "\341\236\230\341\236\273\341\236\201\341\236\204\341\236\266\341\236\232 **\341\236\227\341\237\222\341\236\207\341\236\266\341\236\224\341\237\213\341\236\257\341\236\200\341\236\237\341\236\266\341\236\232 (Upload \341\236\257\341\236\200\341\236\237\341\236\266\341\236\232) \341\236\254\341\236\224\341\236\211\341\237\222\341\236\205\341\236\274\341\236\233\341\236\217\341\237\206\341\236\216\341\236\227\341\237\222\341\236\207\341\236\266\341\236\224\341\237\213\341\236\257\341\236\200\341\236\237\341\236\266\341\236\232 (Google Drive / Web Link)** \341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\341\236\224\341\236\266\341\236\223\341\236\224\341\236\223\341\237\222\341\236\220\341\237\202\341\236\230\341\236\231\341\237\211\341\236\266\341\236\204\341\236\226\341\237\201\341\236\211\341\236\233\341\237\201\341\236\211\341\236\224\341\236\223\341\237\222\341\236\221\341\236\266\341\236\224\341\237\213\341\236\226\341\236\270 \302\253\341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227\302\273 \341\236\221\341\236\266\341\237\206\341\236\204\341\236\233\341\236\276 **\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\205\341\237\201\341\236\211** \341\236\223\341\236\267\341\236\204 **\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\205\341\236\274\341\236\233**\341\237\226\n\n### \341\237\241. Form \341\236\224\341\236\211\341\237\222\341\236\205\341\236\274\341\236\233 \341\236\223\341\236\267\341\236\204\341\236\200\341\237\202\341\236\224\341\237\222\341\236\232\341\237\202\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217 (Outgoing & Incoming Modals)\n- **\341\236\221\341\236\270\341\236\217\341\236\266\341\237\206\341\236\204\341\237\226** \341\236\237\341\237\222\341\236\220\341\236\267\341\236\217\341\236\223\341\237\205\341\236\224\341\236\223\341\237\222\341\236\221\341\236\266\341\236\224\341\237\213\341\236\226\341\236\270\341\236\207\341\236\275\341\236\232 \302\253\341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227\302\273 \341\236\225\341\237\222\341\236\221\341\236\266\341\236\233\341\237\213\341\237\224\n- **\341\236\230\341\236\273\341\236\201\341\236\204\341\236\266\341\236\232\341\236\202\341\236\266\341\237\206\341\236\221\341\237\222\341\236\232 \341\237\242 \341\236\207\341\236\230\341\237\222\341\236\232\341\236\276\341\236\237\341\237\226**\n  1. **\360\237\223\201 \341\236\225\341\237\222\341\236\221\341\236\273\341\236\200\341\236\241\341\236\276\341\236\204\341\236\257\341\236\200\341\236\237\341\236\266\341\236\232 (Upload File)\341\237\226**\n     - \341\236\242\341\236\266\341\236\205\341\236\207\341\237\222\341\236\232\341\236\276\341\236\237\341\236\232\341\236\276\341\236\237 \341\236\254\341\236\242\341\236\274\341\236\237\341\236\221\341\236\230\341\237\222\341\236\233\341\236\266\341\236\200\341\237\213 (Drag & Drop) \341\236\257\341\236\200\341\236\237\341\236\266\341\236\232\341\236\212\341\236\274\341\236\205\341\236\207\341\236\266 PDF, \341\236\232\341\236\274\341\236\224\341\236\227\341\236\266\341\236\226 (JPG, PNG), Word, Excel...\n     - \341\236\257\341\236\200\341\236\237\341\236\266\341\236\232\341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\341\236\224\341\236\266\341\236\223\341\236\242\341\236\266\341\236\223 \341\236\223\341\236\267\341\236\204\341\236\232\341\236\200\341\237\222\341\236\237\341\236\266\341\236\221\341\236\273\341\236\200\341\236\200\341\237\222\341\236\223\341\236\273\341\236\204\341\236\224\341\237\222\341\236\232\341\236\226\341\237\220\341\236\223\341\237\222\341\236\222\341\236\212\341\237\204\341\236\231\341\236\237\341\237\222\341\236\234\341\237\220\341\236\231\341\236\224\341\237\222\341\236\232\341\236\234\341\236\217\341\237\222\341\236\217\341\236\267\