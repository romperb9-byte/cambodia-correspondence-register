        }
        lines {
          text: "  \'\341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204\341\236\225\341\237\202\341\236\223\341\236\200\341\236\266\341\236\232\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
