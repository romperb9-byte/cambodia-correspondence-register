          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204\341\236\224\341\237\222\341\236\232\341\237\203\341\236\237\341\236\216\341\236\270\341\236\231\341\237\215 \341\236\223\341\236\267\341\236\204\341\236\221\341\236\274\341\236\232\341\236\202\341\236\230\341\236\223\341\236\266\341\236\202\341\236\230\341\236\223\341\237\215\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
