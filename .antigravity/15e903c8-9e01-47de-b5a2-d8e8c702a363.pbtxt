    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { OutgoingLetter } from \'../types\';\nimport { CAMBODIAN_INSTITUTIONS, KHMER_MONTHS } from \'../utils/khmerNumerals\';\nimport { X, Calendar, Building, Hash, FileText, Check } from \'lucide-react\';\n\ninterface Props {\n  isOpen: boolean;\n  onClose: () => void;\n  onSave: (letter: OutgoingLetter) => void;\n  existingLetter?: OutgoingLetter | null;\n  nextSuggestedNumber: number;\n  currentYear: number;\n}\n\nexport const OutgoingLetterModal: React.FC<Props> = ({\n  isOpen,\n  onClose,\n  onSave,\n  existingLetter,\n  nextSuggestedNumber,\n  currentYear,\n}) => {\n  const [recordNumber, setRecordNumber] = useState<number>(nextSuggestedNumber);\n  const [summary, setSummary] = useState(\'\');\n  const [day, setDay] = useState<number>(new Date().getDate());\n  const [month, setMonth] = useState<number>(new Date().getMonth() + 1);\n  const [year, setYear] = useState<number>(currentYear);\n  const [quantity, setQuantity] = useState<number>(1);\n  const [recipientMinistry, setRecipientMinistry] = useState(CAMBODIAN_INSTITUTIONS[0]);\n  const [customMinistry, setCustomMinistry] = useState(\'\');\n  const [isCustomMinistry, setIsCustomMinistry] = useState(false);\n  const [remarks, setRemarks] = useState(\'\');\n\n  const [errors, setErrors] = useState<{ [key: string]: string }>({});\n\n  useEffect(() => {\n    if (existingLetter) {\n      setRecordNumber(existingLetter.recordNumber);\n      setSummary(existingLetter.summary);\n      setDay(existingLetter.day);\n      setMonth(existingLetter.month);\n      setYear(existingLetter.year);\n      setQuantity(existingLetter.quantity);\n      setRemarks(existingLetter.remarks || \'\');\n\n      if (CAMBODIAN_INSTITUTIONS.includes(existingLetter.recipientMinistry)) {\n        setRecipientMinistry(existingLetter.recipientMinistry);\n        setIsCustomMinistry(false);\n        setCustomMinistry(\'\');\n      } else {\n        setRecipientMinistry(\'custom\');\n        setIsCustomMinistry(true);\n        setCustomMinistry(existingLetter.recipientMinistry);\n      }\n    } else {\n      setRecordNumber(nextSuggestedNumber);\n      setSummary(\'\');\n      const now = new Date();\n      setDay(now.getDate());\n      setMonth(now.getMonth() + 1);\n      setYear(currentYear);\n      setQuantity(1);\n      setRecipientMinistry(CAMBODIAN_INSTITUTIONS[0]);\n      setIsCustomMinistry(false);\n      setCustomMinistry(\'\');\n      setRemarks(\'\');\n    }\n    setErrors({});\n  }, [existingLetter, nextSuggestedNumber, currentYear, isOpen]);\n\n  if (!isOpen) return null;\n\n  const handleMinistrySelect = (val: string) => {\n    if (val === \'custom\') {\n      setIsCustomMinistry(true);\n      setRecipientMinistry(\'custom\');\n    } else {\n      setIsCustomMinistry(false);\n      setRecipientMinistry(val);\n      setCustomMinistry(\'\');\n    }\n  };\n\n  const handleSetToday = () => {\n    const now = new Date();\n    setDay(now.getDate());\n    setMonth(now.getMonth() + 1);\n    setYear(now.getFullYear());\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n\n    const newErrors: { [key: string]: string } = {};\n\n    if (!recordNumber || recordNumber <= 0) {\n      newErrors.recordNumber = \'\341\236\237\341\236\274\341\236\230\341\236\224\341\236\211\341\237\222\341\236\205\341\236\274\341\236\233\341\236\233\341\237\201\341\236\201\341\236\232\341\237\200\341\236\204\341\236\261\341\237\222\341\236\231\341\236\224\341\236\266\341\236\223\341\236\217\341\237\222\341\236\232\341\236\271\341\236\230\341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\';\n    }\n    if (!summary.trim()) {\n      newErrors.summary = \'\341\236\237\341\236\274\341\236\230\341\236\224\341\236\211\341\237\222\341\236\205\341\236\274\341\236\233\341\236\201\341\237\222\341\236\233\341\236\271\341\236\230\341\236\237\341\236\266\341\236\232\341\236\237\341\236\204\341\237\222\341\236\201\341\237\201\341\236\224\341\236\232\341\236\224\341\236\237\341\237\213\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\';\n    }\n    if (!day || day < 1 || day > 31) {\n      newErrors.day = \'\341\236\220\341\237\222\341\236\204\341\237\203\341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\341\236\223\341\237\205\341\236\205\341\236\223\341\237\222\341\236\233\341\237\204\341\237\207\341\236\226\341\236\270 1 \341\236\212\341\236\233\341\237\213 31\';\n    }\n    if (!month || month < 1 || month > 12) {\n      newErrors.month = \'\341\236\201\341\237\202\341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\341\236\223\341\237\205\341\236\205\341\236\223\341\237\222\341\236\233\341\237\204\341\237\207\341\236\226\341\236\270 1 \341\236\212\341\236\233\341\237\213 12\';\n    }\n    if (!year || year < 2000 || year > 2100) {\n      newErrors.year = \'\341\236\206\341\237\222\341\236\223\341\236\266\341\237\206\341\236\230\341\236\267\341\236\223\341\236\217\341\237\222\341\236\232\341\236\271\341\236\230\341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\';\n    }\n    if (!quantity || quantity <= 0) {\n      newErrors.quantity = \'\341\236\205\341\237\206\341\236\223\341\236\275\341\236\223\341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\341\236\222\341\237\206\341\236\207\341\236\266\341\236\204 0\';\n    }\n\n    const finalMinistry = isCustomMinistry ? customMinistry.trim() : recipientMinistry.trim();\n    if (!finalMinistry) {\n      newErrors.ministry = \'\341\236\237\341\236\274\341\236\230\341\236\207\341\237\222\341\236\232\341\236\276\341\236\237 \341\236\254\341\236\224\341\236\211\341\237\222\341\236\205\341\236\274\341\236\233\341\236\210\341\237\222\341\236\230\341\237\204\341\237\207\341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204\341\236\221\341\236\221\341\236\275\341\236\233\';\n    }\n\n    if (Object.keys(newErrors).length > 0) {\n      setErrors(newErrors);\n      return;\n    }\n\n    const letterToSave: OutgoingLetter = {\n      id: existingLetter?.id || `out-${Date.now()}-${Math.random().toString(36).substr(2, 6)}`,\n      recordNumber: Number(recordNumber),\n      summary: summary.trim(),\n      day: Number(day),\n      month: Number(month),\n      year: Number(year),\n      quantity: Number(quantity),\n      recipientMinistry: finalMinistry,\n      remarks: remarks.trim(),\n      createdAt: existingLetter?.createdAt || new Date().toISOString(),\n    };\n\n    onSave(letterToSave);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs animate-in fade-in\">\n      <div className=\"bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-xl overflow-hidden max-h-[92vh] flex flex-col\">\n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-amber-50/50\">\n          <div>\n            <h2 className=\"text-base font-bold text-slate-900 font-moul\">\n              {existingLetter ? \'\341\236\200\341\237\202\341\236\224\341\237\222\341\236\232\341\237\202\341\236\200\341\237\206\341\236\216\341\236\217\341\237\213\341\236\217\341\237\222\341\236\232\341\236\266\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\205\341\237\201\341\236\211\' : \'\341\236\205\341\236\273\341\237\207\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\205\341\237\201\341\236\211\341\236\220\341\237\222\341\236\230\341\236\270\'}\n            </h2>\n            <p className=\"text-xs text-slate-500\">\n              \341\236\221\341\236\230\341\237\222\341\236\232\341\236\204\341\237\213\341\236\224\341\237\202\341\236\224\341\236\224\341\236\221\341\236\200\341\236\217\341\237\213\341\236\217\341\237\222\341\236\232\341\236\266\341\236\237\341\237\200\341\236\234\341\236\227\341\237\205\341\236\205\341\236\273\341\237\207\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\205\341\237\201\341\236\211\341\236\225\341\237\222\341\236\233\341\236\274\341\236\234\341\236\200\341\236\266\341\236\232\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors\"\n          >\n            <X size={18} />\n          </button>\n        </div>\n\n        {/* Modal Form */}\n        <form onSubmit={handleSubmit} className=\"p-6 overflow-y-auto space-y-4 text-xs\">\n          {/* Row 1: \341\236\233\341\237\201\341\236\201\341\236\232\341\237\200\341\236\204 & \341\236\205\341\237\206\341\236\223\341\236\275\341\236\223 */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-slate-700 font-semibold mb-1 flex items-center gap-1.5\">\n                <Hash size={13} className=\"text-amber-700\" />\n                <span>\341\236\233\341\237\201\341\236\201\341\236\232\341\237\200\341\236\204 (\341\236\233.\341\236\232) *</span>\n              </label>\n              <input\n                type=\"number\"\n                min=\"1\"\n                required\n                value={recordNumber}\n                onChange={(e) => setRecordNumber(Number(e.target.value))}\n                className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg font-bold text-slate-900 focus:bg-white focus:border-amber-600 focus:outline-hidden tabular-nums\"\n              />\n              {errors.recordNumber && (\n                <span className=\"text-[11px] text-rose-600 mt-1 block\">{errors.recordNumber}</span>\n              )}\n            </div>\n\n            <div>\n              <label className=\"block text-slate-700 font-semibold mb-1\">\n                \341\236\205\341\237\206\341\236\223\341\236\275\341\236\223 (\341\236\205\341\237\222\341\236\224\341\236\266\341\236\224\341\237\213/\341\236\257\341\236\200\341\236\237\341\236\266\341\236\232) *\n              </label>\n              <input\n                type=\"number\"\n                min=\"1\"\n                required\n                value={quantity}\n                onChange={(e) => setQuantity(Number(e.target.value))}\n                className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:bg-white focus:border-amber-600 focus:outline-hidden tabular-nums\"\n              />\n              {errors.quantity && (\n                <span className=\"text-[11px] text-rose-600 mt-1 block\">{errors.quantity}</span>\n              )}\n            </div>\n          </div>\n\n          {/* Row 2: \341\236\200\341\236\266\341\236\233\341\236\224\341\236\232\341\236\267\341\236\205\341\237\222\341\236\206\341\237\201\341\236\221 (\341\236\220\341\237\222\341\236\204\341\237\203 \341\236\201\341\237\202 \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206) */}\n          <div className=\"bg-slate-50/70 p-3.5 rounded-xl border border-slate-200/80 space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"text-slate-700 font-semibold flex items-center gap-1.5\">\n                <Calendar size={14} className=\"text-amber-700\" />\n                <span>\341\236\200\341\236\266\341\236\233\341\236\224\341\236\232\341\236\267\341\236\205\341\237\222\341\236\206\341\237\201\341\236\221\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217 (\341\236\220\341\237\222\341\236\204\341\237\203 \341\236\201\341\237\202 \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206) *</span>\n              </label>\n              <button\n                type=\"button\"\n                onClick={handleSetToday}\n                className=\"text-[11px] text-amber-800 hover:text-amber-900 font-medium hover:underline\"\n              >\n                \341\236\231\341\236\200\341\236\220\341\237\222\341\236\204\341\237\203\341\236\223\341\237\201\341\237\207\n              </button>\n            </div>\n\n            <div className=\"grid grid-cols-3 gap-2\">\n              <div>\n                <span className=\"text-[11px] text-slate-500 block mb-0.5\">\341\236\220\341\237\222\341\236\204\341\237\203 (1-31)</span>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  max=\"31\"\n                  required\n                  value={day}\n                  onChange={(e) => setDay(Number(e.target.value))}\n                  className=\"w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-md text-slate-900 focus:border-amber-600 focus:outline-hidden tabular-nums text-center\"\n                />\n              </div>\n\n              <div>\n                <span className=\"text-[11px] text-slate-500 block mb-0.5\">\341\236\201\341\237\202 (1-12)</span>\n                <select\n                  value={month}\n                  onChange={(e) => setMonth(Number(e.target.value))}\n                  className=\"w-full px-2 py-1.5 bg-white border border-slate-200 rounded-md text-slate-900 focus:border-amber-600 focus:outline-hidden text-center truncate\"\n                >\n                  {KHMER_MONTHS.map((m, idx) => (\n                    <option key={idx} value={idx + 1}>\n                      \341\236\201\341\237\202 {idx + 1} ({m})\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              <div>\n                <span className=\"text-[11px] text-slate-500 block mb-0.5\">\341\236\206\341\237\222\341\236\223\341\236\266\341\237\206</span>\n                <input\n                  type=\"number\"\n                  min=\"2000\"\n                  max=\"2099\"\n                  required\n                  value={year}\n                  onChange={(e) => setYear(Number(e.target.value))}\n                  className=\"w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-md text-slate-900 focus:border-amber-600 focus:outline-hidden tabular-nums text-center\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Row 3: \341\236\201\341\237\222\341\236\233\341\236\271\341\236\230\341\236\237\341\236\266\341\236\232\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217 */}\n          <div>\n            <label className=\"block text-slate-700 font-semibold mb-1 flex items-center gap-1.5\">\n              <FileText size={13} className=\"text-amber-700\" />\n              <span>\341\236\201\341\237\222\341\236\233\341\236\271\341\236\230\341\236\237\341\236\266\341\236\232\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217 *</span>\n            </label>\n            <textarea\n              rows={3}\n              required\n              placeholder=\"\341\236\200\341\236\217\341\237\213\341\236\217\341\237\222\341\236\232\341\236\266\341\236\201\341\237\222\341\236\233\341\236\271\341\236\230\341\236\237\341\236\266\341\236\232\341\236\237\341\236\204\341\237\222\341\236\201\341\237\201\341\236\224 \341\236\254\341\236\200\341\236\230\341\237\222\341\236\230\341\236\234\341\236\217\341\237\222\341\236\220\341\236\273\341\236\223\341\237\203\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\212\341\237\202\341\236\233\341\236\224\341\236\266\341\236\223\341\236\225\341\237\222\341\236\211\341\236\276\341\236\205\341\237\201\341\236\211...\"\n              value={summary}\n              onChange={(e) => setSummary(e.target.value)}\n              className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:bg-white focus:border-amber-600 focus:outline-hidden leading-relaxed\"\n            />\n            {errors.summary && (\n              <span className=\"text-[11px] text-rose-600 mt-1 block\">{errors.summary}</span>\n            )}\n          </div>\n\n          {/* Row 4: \341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204\341\236\221\341\236\221\341\236\275\341\236\233 */}\n          <div>\n            <label className=\"block text-slate-700 font-semibold mb-1 flex items-center gap-1.5\">\n              <Building size={13} className=\"text-amber-700\" />\n              <span>\341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204\341\236\221\341\236\221\341\236\275\341\236\233 / \341\236\237\341\237\222\341\236\220\341\236\266\341\236\224\341\237\220\341\236\223\341\236\221\341\236\221\341\236\275\341\236\233 *</span>\n            </label>\n            <select\n              value={isCustomMinistry ? \'custom\' : recipientMinistry}\n              onChange={(e) => handleMinistrySelect(e.target.value)}\n              className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:bg-white focus:border-amber-600 focus:outline-hidden mb-2\"\n            >\n              {CAMBODIAN_INSTITUTIONS.map((inst) => (\n                <option key={inst} value={inst}>\n                  {inst}\n                </option>\n              ))}\n              <option value=\"custom\">-- \341\236\224\341\236\211\341\237\222\341\236\205\341\236\274\341\236\233\341\236\210\341\237\222\341\236\230\341\237\204\341\237\207\341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204/\341\236\237\341\237\222\341\236\220\341\236\266\341\236\224\341\237\220\341\236\223\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\236\221\341\237\200\341\236\217 --</option>\n            </select>\n\n            {isCustomMinistry && (\n              <input\n                type=\"text\"\n                placeholder=\"\341\236\234\341\236\266\341\236\231\341\236\224\341\236\211\341\237\222\341\236\205\341\236\274\341\236\233\341\236\210\341\237\222\341\236\230\341\237\204\341\237\207\341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204 \341\236\230\341\236\223\341\237\222\341\236\221\341\236