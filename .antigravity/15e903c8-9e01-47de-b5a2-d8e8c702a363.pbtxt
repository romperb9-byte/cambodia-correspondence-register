341\236\237\341\236\266\341\236\232 \341\236\254\341\236\217\341\237\206\341\236\216\341\236\232\341\236\233\341\236\267\341\236\204 \341\236\257\341\236\200\341\236\237\341\236\266\341\236\232 */}\n          <AttachmentField\n            attachmentUrl={attachmentUrl}\n            attachmentName={attachmentName}\n            attachmentType={attachmentType}\n            onChange={(data) => {\n              setAttachmentUrl(data.url || \'\');\n              setAttachmentName(data.name || \'\');\n              setAttachmentType(data.type);\n            }}\n          />"
