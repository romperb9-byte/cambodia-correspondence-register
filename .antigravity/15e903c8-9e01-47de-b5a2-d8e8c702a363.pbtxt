          text: "                  const dateDisplay = `\341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 ${settings.useKhmerDigits ? toKhmerNum(dayStr) : dayStr} \341\236\201\341\237\202 ${settings.useKhmerDigits ? toKhmerNum(monthStr) : monthStr} \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 ${settings.useKhmerDigits ? toKhmerNum(item.year) : item.year}`;"
