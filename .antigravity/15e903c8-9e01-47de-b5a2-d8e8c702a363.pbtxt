          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204\341\236\200\341\236\266\341\236\232\341\236\204\341\236\266\341\236\232 \341\236\223\341\236\267\341\236\204\341\236\224\341\236\216\341\237\222\341\236\217\341\236\273\341\237\207\341\236\224\341\236\216\341\237\222\341\236\217\341\236\266\341\236\233\341\236\234\341\236\267\341\236\207\341\237\222\341\236\207\341\236\266\341\236\207\341\236\270\341\236\234\341\237\210\',"
