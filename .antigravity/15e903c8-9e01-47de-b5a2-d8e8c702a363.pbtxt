t-slate-600 font-normal flex items-center gap-1.5\\\">\\n                          <Building size={13} className=\\\"text-blue-700/70 shrink-0\\\" />\\n                          <span className=\\\"font-medium text-blue-900\\\">{item.senderMinistry}</span>\\n                        </div>\\n                      </td>\\n\\n                      {/* Column 3: \341\236\205\341\237\206\341\236\223\341\236\275\341\236\223 */}\\n                      <td className=\\\"py-3 px-3 border-r border-slate-200 text-center text-slate-800 tabular-nums font-medium\\\">\\n                        {settings.useKhmerDigits ? toKhmerNum(item.quantity) : item.quantity} <span className=\\\"text-[11px] text-slate-500 font-normal\\\">\341\236\205\341\237\222\341\236\224\341\236\266\341\236\224\341\237\213</span>\\n                      </td>\\n\\n                      {/* Column 4: \341\236\233\341\237\201\341\236\201\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\212\341\236\276\341\236\230 \341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 \341\236\201\341\237\202 \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 */}\\n                      <td className=\\\"py-3 px-4 border-r border-slate-200 text-slate-900\\\">\\n                        <div className=\\\"font-medium text-slate-900 mb-1 flex items-center gap-1.5\\\">\\n                          <Tag size={13} className=\\\"text-blue-600 shrink-0\\\" />\\n                          <span>\341\236\233\341\237\201\341\236\201\341\237\226 <strong className=\\\"text-blue-950\\\">{item.originalLetterNumber || \'\341\236\202\341\237\222\341\236\230\341\236\266\341\236\223\'}</strong></span>\\n                        </div>\\n                        <div className=\\\"text-xs text-slate-500 font-normal flex items-center gap-1\\\">\\n                          <Calendar size={13} className=\\\"text-slate-400 shrink-0\\\" />\\n                          <span>{dateDisplay}</span>\\n             