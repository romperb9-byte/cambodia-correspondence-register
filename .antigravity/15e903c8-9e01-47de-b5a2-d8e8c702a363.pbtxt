        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function exportToCSV(filename: string, rows: (string | number)[][]): void {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const processRow = (row: (string | number)[]) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return row"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      .map((val) => {"
