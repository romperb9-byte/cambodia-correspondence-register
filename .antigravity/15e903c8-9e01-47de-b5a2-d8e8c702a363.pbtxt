    replacement_infos {
      original_chunk {
        target_content: "                {/* 5. \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227 */}\n                <th className=\"py-3 px-4 min-w-[150px]\">\n                  \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227\n                </th>\n                {/* Web Action Controls (Hidden on Print) */}\n                <th className=\"no-print py-3 px-2 w-24 bg-slate-200 text-slate-700 font-sans font-medium text-center\">\n                  \341\236\237\341\236\200\341\236\230\341\237\222\341\236\230\341\236\227\341\236\266\341\236\226\n                </th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-200\">\n              {filteredLetters.length === 0 ? (\n                <tr>\n                  <td colSpan={6} className=\"py-12 text-center text-slate-400\">\n                    <p className=\"text-sm\">\341\236\230\341\236\267\341\236\223\341\236\230\341\236\266\341\236\223\341\236\200\341\237\206\341\236\216\341\236\217\341\237\213\341\236\217\341\237\222\341\236\232\341\236\266\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\205\341\236\274\341\236\233\341\236\212\341\237\202\341\236\233\341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\341\236\223\341\236\271\341\236\204\341\236\233\341\236\200\341\237\222\341\236\201\341\236\201\341\236\216\341\237\222\341\236\214\341\236\205\341\236\230\341\237\222\341\236\232\341\237\204\341\237\207\341\236\221\341\237\201</p>\n                    <button\n                      onClick={onAddLetter}\n                      className=\"mt-3 px-3 py-1.5 text-xs text-blue-700 font-medium hover:underline inline-flex items-center gap-1\"\n                    >\n                      <Plus size={14} /> \341\236\205\341\236\273\341\237\207\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\205\341\236\274\341\236\233\341\236\220\341\237\222\341\236\230\341\236\270\n                    </button>\n                  </td>\n                </tr>\n              ) : (\n                filteredLetters.map((item) => {\n                  const dayStr = String(item.day).padStart(2, \'0\');\n                  const monthStr = String(item.month).padStart(2, \'0\');\n                  const dateDisplay = `\341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 ${settings.useKhmerDigits ? toKhmerNum(dayStr) : dayStr} \341\236\201\341\237\202 ${settings.useKhmerDigits ? toKhmerNum(monthStr) : monthStr} \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 ${settings.useKhmerDigits ? toKhmerNum(item.year) : item.year}`;\n                  const numDisplay = padNumber(item.recordNumber, 3, settings.useKhmerDigits);\n\n                  return (\n                    <tr\n                      key={item.id}\n                      className=\"hover:bg-blue-50/40 transition-colors group align-top\"\n                    >\n                      {/* Column 1: \341\236\233.\341\236\232 */}\n                      <td className=\"py-3 px-3 border-r border-slate-200 text-center font-bold text-slate-900 tabular-nums\">\n                        {numDisplay}\n                      </td>\n\n                      {/* Column 2: \341\236\201\341\237\222\341\236\233\341\236\271\341\236\230\341\236\237\341\236\266\341\236\232\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217 \341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204\341\236\212\341\236\276\341\236\230 */}\n                      <td className=\"py-3 px-4 border-r border-slate-200 text-slate-900\">\n                        <div className=\"font-medium text-slate-900 leading-relaxed mb-1.5\">\n                          {item.summary}\n                        </div>\n                        <div className=\"text-xs text-slate-600 font-normal flex items-center gap-1.5\">\n                          <Building size={13} className=\"text-blue-700/70 shrink-0\" />\n                          <span className=\"font-medium text-blue-900\">{item.senderMinistry}</span>\n                        </div>\n                      </td>\n\n                      {/* Column 3: \341\236\205\341\237\206\341\236\223\341\236\275\341\236\223 */}\n                      <td className=\"py-3 px-3 border-r border-slate-200 text-center text-slate-800 tabular-nums font-medium\">\n                        {settings.useKhmerDigits ? toKhmerNum(item.quantity) : item.quantity} <span className=\"text-[11px] text-slate-500 font-normal\">\341\236\205\341\237\222\341\236\224\341\236\266\341\236\224\341\237\213</span>\n                      </td>\n\n                      {/* Column 4: \341\236\233\341\237\201\341\236\201\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\212\341\236\276\341\236\230 \341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 \341\236\201\341\237\202 \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 */}\n                      <td className=\"py-3 px-4 border-r border-slate-200 text-slate-900\">\n                        <div className=\"font-medium text-slate-900 mb-1 flex items-center gap-1.5\">\n                          <Tag size={13} className=\"text-blue-600 shrink-0\" />\n                          <span>\341\236\233\341\237\201\341\236\201\341\237\226 <strong className=\"text-blue-950\">{item.originalLetterNumber || \'\341\236\202\341\237\222\341\236\230\341\236\266\341\236\223\'}</strong></span>\n                        </div>\n                        <div className=\"text-xs text-slate-500 font-normal flex items-center gap-1\">\n                          <Calendar size={13} className=\"text-slate-400 shrink-0\" />\n                          <span>{dateDisplay}</span>\n                        </div>\n                      </td>\n\n                      {/* Column 5: \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227 */}\n                      <td className=\"py-3 px-4 text-slate-600 text-xs leading-relaxed\">\n                        {item.remarks || <span className=\"text-slate-300\">-</span>}\n                      </td>"
        replacement_content: "                {/* 5. \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227 */}\n                <th className=\"py-3 px-4 border-r border-slate-300 min-w-[150px]\">\n                  \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227\n                </th>\n                {/* 6. \341\236\257\341\236\200\341\236\237\341\236\266\341\236\232\341\236\227\341\237\222\341\236\207\341\236\266\341\236\224\341\237\213 (\341\236\224\341\236\223\341\237\222\341\236\221\341\236\266\341\236\224\341\237\213\341\236\226\341\236\270 \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227) */}\n                <th className=\"no-print py-3 px-3 border-r border-slate-300 w-36 sm:w-44 text-center\">\n                  \341\236\257\341\236\200\341\236\237\341\236\266\341\236\232\341\236\227\341\237\222\341\236\207\341\236\266\341\236\224\341\237\213\n                </th>\n                {/* Web Action Controls (Hidden on Print) */}\n                <th className=\"no-print py-3 px-2 w-24 bg-slate-200 text-slate-700 font-sans font-medium text-center\">\n                  \341\236\237\341\236\200\341\236\230\341\237\222\341\236\230\341\236\227\341\236\266\341\236\226\n                </th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-200\">\n              {filteredLetters.length === 0 ? (\n                <tr>\n                  <td colSpan={7} className=\"py-12 text-center text-slate-400\">\n                    <p className=\"text-sm\">\341\236\230\341\236\267\341\236\223\341\236\230\341\236\266\341\236\223\341\236\200\341\237\206\341\236\216\341\236\217\341\237\213\341\236\217\341\237\222\341\236\232\341\236\266\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\205\341\236\274\341\236\233\341\236\212\341\237\202\341\236\233\341\236\217\341\237\222\341\236\232\341\236\274\341\236\234\341\236\223\341\236\271\341\236\204\341\236\233\341\236\200\341\237\222\341\236\201\341\236\201\341\236\216\341\237\222\341\236\214\341\236\205\341\236\230\341\237\222\341\236\232\341\237\204\341\237\207\341\236\221\341\237\201</p>\n                    <button\n                      onClick={onAddLetter}\n                      className=\"mt-3 px-3 py-1.5 text-xs text-blue-700 font-medium hover:underline inline-flex items-center gap-1\"\n                    >\n                      <Plus size={14} /> \341\236\205\341\236\273\341\237\207\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\205\341\236\274\341\236\233\341\236\220\341\237\222\341\236\230\341\236\270\n                    </button>\n                  </td>\n                </tr>\n              ) : (\n                filteredLetters.map((item) => {\n                  const dayStr = String(item.day).padStart(2, \'0\');\n                  const monthStr = String(item.month).padStart(2, \'0\');\n                  const dateDisplay = `\341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 ${settings.useKhmerDigits ? toKhmerNum(dayStr) : dayStr} \341\236\201\341\237\202 ${settings.useKhmerDigits ? toKhmerNum(monthStr) : monthStr} \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 ${settings.useKhmerDigits ? toKhmerNum(item.year) : item.year}`;\n                  const numDisplay = padNumber(item.recordNumber, 3, settings.useKhmerDigits);\n\n                  return (\n                    <tr\n                      key={item.id}\n                      className=\"hover:bg-blue-50/40 transition-colors group align-top\"\n                    >\n                      {/* Column 1: \341\236\233.\341\236\232 */}\n                      <td className=\"py-3 px-3 border-r border-slate-200 text-center font-bold text-slate-900 tabular-nums\">\n                        {numDisplay}\n                      </td>\n\n                      {/* Column 2: \341\236\201\341\237\222\341\236\233\341\236\271\341\236\230\341\236\237\341\236\266\341\236\232\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217 \341\236\200\341\237\222\341\236\232\341\236\237\341\236\275\341\236\204\341\236\212\341\236\276\341\236\230 */}\n                      <td className=\"py-3 px-4 border-r border-slate-200 text-slate-900\">\n                        <div className=\"font-medium text-slate-900 leading-relaxed mb-1.5\">\n                          {item.summary}\n                        </div>\n                        <div className=\"text-xs text-slate-600 font-normal flex items-center gap-1.5\">\n                          <Building size={13} className=\"text-blue-700/70 shrink-0\" />\n                          <span className=\"font-medium text-blue-900\">{item.senderMinistry}</span>\n                        </div>\n                      </td>\n\n                      {/* Column 3: \341\236\205\341\237\206\341\236\223\341\236\275\341\236\223 */}\n                      <td className=\"py-3 px-3 border-r border-slate-200 text-center text-slate-800 tabular-nums font-medium\">\n                        {settings.useKhmerDigits ? toKhmerNum(item.quantity) : item.quantity} <span className=\"text-[11px] text-slate-500 font-normal\">\341\236\205\341\237\222\341\236\224\341\236\266\341\236\224\341\237\213</span>\n                      </td>\n\n                      {/* Column 4: \341\236\233\341\237\201\341\236\201\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\212\341\236\276\341\236\230 \341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 \341\236\201\341\237\202 \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 */}\n                      <td className=\"py-3 px-4 border-r border-slate-200 text-slate-900\">\n                        <div className=\"font-medium text-slate-900 mb-1 flex items-center gap-1.5\">\n                          <Tag size={13} className=\"text-blue-600 shrink-0\" />\n                          <span>\341\236\233\341\237\201\341\236\201\341\237\226 <strong className=\"text-blue-950\">{item.originalLetterNumber || \'\341\236\202\341\237\222\341\236\230\341\236\266\341\236\223\'}</strong></span>\n                        </div>\n                        <div className=\"text-xs text-slate-500 font-normal flex items-center gap-1\">\n                          <Calendar size={13} className=\"text-slate-400 shrink-0\" />\n                          <span>{dateDisplay}</span>\n                        </div>\n                      </td>\n\n                      {/* Column 5: \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227 */}\n                      <td className=\"py-3 px-4 border-r border-slate-200 text-slate-600 text-xs leading-relaxed\">\n                        {item.remarks || <span className=\"text-slate-300\">-</span>}\n                      </td>\n\n                      {/* Column 6: \341\236\257\341\236\200\341\236\237\341\236\266\341\236\232\341\236\227\341\237\222\341\236\207\341\236\266\341\236\224\341\237\213 (\341\236\224\341\236\223\341\237\222\341\236\221\341\236\266\341\236\224\341\237\213\341\236\226\341\236\270 \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227) */}\n                      <td className=\"no-print py-3 px-3 border-r border-slate-200 text-center align-middle\">\n                        {item.attachmentUrl ? (\n                          <a\n                            href={item.attachmentUrl}\n                            target=\"_blank\"\n                            rel=\"noopener noreferrer\"\n                            className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-900 border border-blue-200/80 text-xs font-medium transition-colors max-w-full group/btn\"\n                            title={item.attachmentName || \'\341\236\224\341\236\276\341\236\200\341\236\230\341\236\276\341\236\233\341\236\257\341\236\200\341\236\237\341\236\266\341\236\232\341\236\227\341\237\222\341\236\207\341\236\266\341\236\224\341\237\213\'}\n                          >\n                            {item.attachmentType === \'link\' ? (\n                              <Link2 size={13} className=\"text-blue-700 shrink-0\" />\n                            ) : (\n                              <FileText size={13} className=\"text-blue-700 shrink-0\" />\n                            )}\n                            <span className=\"truncate max-w-[90px] sm:max-w-[120px]\">\n                              {item.attachmentName || (item.attachmentType === \'link\' ? \'\341\236\217\341\237\206\341\236\216\341\236\227\341\237\222\341\236\207\341\236\266\341\236\224\341\237\213\' : \'\341\236\257\341\236\200\341\236\237\341\236\266\341\236\232\')}\n                            </span>\n                            <ExternalLink size={11} className=\"text-blue-600 shrink-0 group-hover/btn:translate-x-0.5 transition-transform\" />\n                          </a>\n                        ) : (\n                          <span className=\"text-slate-300\">-</span>\n                        )}\n                      </td>"
      }
      num_matches: 1
    }
  }
}
