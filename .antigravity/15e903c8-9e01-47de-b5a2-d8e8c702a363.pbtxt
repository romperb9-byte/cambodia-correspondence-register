    content: "              <FileText size={13} className=\"text-blue-700\" />\n              <span>\341\236\201\341\237\222\341\236\233\341\236\271\341\236\230\341\236\237\341\236\266\341\236\232\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217 *</span>\n            </label>\n            <textarea\n              rows={3}\n              required\n              placeholder=\"\341\236\200\341\236\217\341\237\213\341\236\217\341\237\222\341\236\232\341\236\266\341\236\201\341\237\222\341\236\233\341\236\271\341\236\230\341\236\237\341\236\266\341\236\232\341\236\237\341\236\204\341\237\222\341\236\201\341\237\201\341\236\224 \341\236\254\341\236\200\341\236\230\341\237\222\341\236\230\341\236\234\341\236\217\341\237\222\341\236\220\341\236\273\341\236\223\341\237\203\341\236\233\341\236\267\341\236\201\341\236\267\341\236\217\341\236\212\341\237\202\341\236\233\341\236\224\341\236\266\341\236\223\341\236\221\341\236\221\341\236\275\341\236\233...\"\n              value={summary}\n              onChange={(e) => setSummary(e.target.value)}\n              className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:bg-white focus:border-blue-600 focus:outline-hidden leading-relaxed\"\n            />\n            {errors.summary && (\n              <span className=\"text-[11px] text-rose-600 mt-1 block\">{errors.summary}</span>\n            )}\n          </div>\n\n          {/* Row 6: \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227 */}\n          <div>\n            <label className=\"block text-slate-700 font-semibold mb-1\">\n              \341\236\237\341\237\201\341\236\205\341\236\200\341\237\222\341\236\212\341\236\270\341\236\225\341\237\222\341\236\237\341\237\201\341\236\204\341\237\227 (\341\236\200\341\237\206\341\236\216\341\236\217\341\237\213\341\236\237\341\236\230\341\237\222\341\236\202\341\236\266\341\2