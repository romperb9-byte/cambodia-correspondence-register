        }
        lines {
          text: "  \'\341\236\230\341\236\223\341\237\222\341\236\221\341\236\270\341\236\232\341\236\242\341\236\224\341\237\213\341\236\232\341\237\206 \341\236\231\341\236\273\341\236\234\341\236\207\341\236\223 \341\236\223\341\236\267\341\236\204\341\236\200\341\236\270\341\236\241\341\236\266 \341\236\201\341\237\201\341\236\217\341\237\222\341\236\217\341\236\200\341\236\216\341\237\222\341\236\212\341\236\266\341\236\233\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\230\341\236\223\341\237\222\341\236\221\341\236\270\341\236\232\341\236\242\341\236\224\341\237\213\341\236\232\341\237\206 \341\236\231\341\236\273\341\236\234\341\236\207\341\236\223 \341\236\223\341\236\267\341\236\204\341\236\200\341\236\270\341\236\241\341\236\266 \341\236\201\341\237\201\341\236\217\341\237\222\341\236\217\341\236\237\341\237\200\341\236\230\341\236\232\341\236\266\341\236\224\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\230\341\236\223\341\237\222\341\236\221\341\236\270\341\236\232\341\236\242\341\236\224\341\237\213\341\236\232\341\237\206 \341\236\231\341\236\273\341\236\234\341\236\207\341\236\223 \341\236\223\341\236\267\341\236\204\341\236\200\341\236\270\341\236\241\341\236\266 \341\236\201\341\237\201\341\236\217\341\237\222\341\236\217\341\236\224\341\236\266\341\236\217\341\237\213\341\236\212\341\237\206\341\236\224\341\236\204\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\230\341\236\223\341\237\222\341\236\221\341\236\270\341\236\232\341\236\242\341\236\224\341\237\213\341\236\232\341\237\206 \341\236\231\341\236\273\341\236\234\341\236\207\341\236\223 \341\236\223\341\236\267\341\236\204\341\236\200\341\236\270\341\236\241\341\236\266 \341\236\201\341\237\201\341\236\217\341\237\222\341\236\217\341\236\200\341\237\206\341\236\226\341\236\204\341\237\213\341\236\205\341\236\266\341\236\230\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\200\341\236\266\341\236\232\341\236\267\341\236\231\341\236\266\341\236\233\341\237\220\341\236\231\341\236\242\341\236\224\341\237\213\341\236\232\341\237\206 \341\236\231\341\236\273\341\236\234\341\236\207\341\236\223 \341\236\223\341\236\267\341\236\204\341\236\200\341\236\270\341\236\241\341\236\266 \341\236\200\341\237\222\341\236\232\341\236\273\341\236\204/\341\236\237\341\237\222\341\236\232\341\236\273\341\236\200/\341\236\201\341\236\216\341\237\222\341\236\214\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\237\341\236\266\341\236\200\341\236\233\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\341\236\233\341\237\220\341\236\231\341\236\227\341\236\274\341\236\230\341\236\267\341\236\223\341\237\222\341\236\221\341\236\227\341\237\222\341\236\223\341\237\206\341\236\226\341\237\201\341\236\211\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\237\341\236\266\341\236\200\341\236\233\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\341\236\233\341\237\220\341\236\231\341\236\207\341\236\266\341\236\217\341\236\267\341\236\224\341\236\266\341\236\217\341\237\213\341\236\212\341\237\206\341\236\224\341\236\204\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\341\236\237\341\237\222\341\236\220\341\236\266\341\236\223\341\236\224\341\236\205\341\237\222\341\236\205\341\237\201\341\236\200\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\341\236\200\341\236\230\341\237\222\341\236\226\341\236\273\341\236\207\341\236\266 (ITC)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\341\236\233\341\237\220\341\236\231 \341\236\223\341\236\267\341\236\204\341\236\242\341\236\223\341\236\273\341\236\234\341\236\267\341\236\221\341\237\222\341\236\231\341\236\266\341\236\233\341\237\220\341\236\231\341\236\200\341\237\222\341\236\223\341\236\273\341\236\204\341\236\217\341\237\206\341\236\224\341\236\223\341\237\213\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\242\341\236\204\341\237\222\341\236\202\341\236\200\341\236\266\341\236\232\341\236\231\341\236\274\341\236\223\341\236\270\341\236\237\341\237\201\341\236\240\341\237\222\341\236\234 (UNICEF)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'\341\236\242\341\236\204\341\237\222\341\236\202\341\236\200\341\236\266\341\236\232\341\236\231\341\236\274\341\236\216\341\237\201\341\236\237\341\237\222\341\236\200\341\236\274 (UNESCO)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * Converts a number or string of digits to Khmer digits"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function toKhmerNum(num: number | string | undefined | null): string {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (num === undefined || num === null) return \'\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return String(num).replace(/[0-9]/g, (char) => KHMER_DIGITS[char] || char);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * Pad number to 3 digits e.g. 1 -> \"001\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function padNumber(num: number, length: number = 3, useKhmer: boolean = false): string {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const padded = String(num).padStart(length, \'0\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return useKhmer ? toKhmerNum(padded) : padded;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * Format date numbers to double digits e.g. 5 -> \"05\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function padZero(val: number | string, useKhmer: boolean = false): string {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const padded = String(val).padStart(2, \'0\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return useKhmer ? toKhmerNum(padded) : padded;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * Calculate book header numbers and dates from a list of records"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function calculateBookHeader("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  records: (OutgoingLetter | IncomingLetter)[],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  useKhmer: boolean = false"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "): CalculatedHeader {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (!records || records.length === 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      fromNumberStr: \'......\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      toNumberStr: \'......\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      totalCount: 0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      fromDateStr: \'\341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 ........ \341\236\201\341\237\202 ............. \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 ............\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      toDateStr: \'\341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 ........ \341\236\201\341\237\202 ............. \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 ............\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Find min and max record numbers"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let minNum = records[0].recordNumber;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let maxNum = records[0].recordNumber;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Track dates"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let minDate = new Date(records[0].year, records[0].month - 1, records[0].day);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let maxDate = new Date(records[0].year, records[0].month - 1, records[0].day);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let minRecord = records[0];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let maxRecord = records[0];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  for (const r of records) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (r.recordNumber < minNum) minNum = r.recordNumber;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (r.recordNumber > maxNum) maxNum = r.recordNumber;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const rDate = new Date(r.year, r.month - 1, r.day);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (rDate < minDate) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      minDate = rDate;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      minRecord = r;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (rDate > maxDate) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      maxDate = rDate;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      maxRecord = r;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const fromNumberStr = padNumber(minNum, 3, useKhmer);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const toNumberStr = padNumber(maxNum, 3, useKhmer);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const totalCount = records.length;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const fromDay = padZero(minRecord.day, useKhmer);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const fromMonth = padZero(minRecord.month, useKhmer);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const fromYear = useKhmer ? toKhmerNum(minRecord.year) : String(minRecord.year);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const toDay = padZero(maxRecord.day, useKhmer);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const toMonth = padZero(maxRecord.month, useKhmer);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const toYear = useKhmer ? toKhmerNum(maxRecord.year) : String(maxRecord.year);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    fromNumberStr,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    toNumberStr,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    totalCount,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    fromDateStr: `\341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 ${fromDay} \341\236\201\341\237\202 ${fromMonth} \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 ${fromYear}`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    toDateStr: `\341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 ${toDay} \341\236\201\341\237\202 ${toMonth} \341\236\206\341\237\222\341\236\223\341\236\266\341\237\206 ${toYear}`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * Format a single letter date nicely"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function formatKhmerDate("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  day: number,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  month: number,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  year: number,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  useKhmer: boolean = false"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "): string {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const d = padZero(day, useKhmer);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const m = padZero(month, useKhmer);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const y = useKhmer ? toKhmerNum(year) : String(year);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return `\341\236\220\341\237\222\341\236\204\341\237\203\341\236\221\341\236\270 ${d}/${m}/${y}`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
    overwrite: true
  }
}
